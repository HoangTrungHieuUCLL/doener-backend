# Copy this file to .env for local development (docker-compose reads it
# automatically). Never commit a real .env file.

# Postgres connection string. Matches the `postgres` service in
# docker-compose.yml by default.
DATABASE_URL=postgresql+psycopg://doener:doener@postgres:5432/doener

# Required in production; this dev value is fine for local docker-compose use.
JWT_SECRET_KEY=dev-only-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=20160

# Comma-separated list of allowed origins for CORS, e.g.:
# CORS_ORIGINS=http://localhost:5173,https://doener.example.com
CORS_ORIGINS=http://localhost:5173

# Port the app binds to (Railway sets this automatically in production).
PORT=8000

# Used only by docker-compose to initialize the postgres service.
POSTGRES_USER=doener
POSTGRES_PASSWORD=doener
POSTGRES_DB=doener
